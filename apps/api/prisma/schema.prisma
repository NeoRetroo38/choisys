generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Declared in ascending privilege order: USER < ADMIN < DEV < SUPERADMIN < SUPERDEV.
/// Only USER and SUPERDEV have dedicated capabilities for now; the others inherit USER's.
enum Role {
  USER
  ADMIN
  DEV
  SUPERADMIN
  SUPERDEV
}

enum CubeDataType {
  SESSION
  RUN
}

enum CubeDataStatus {
  CREATED
  ACTIVE
  COMPLETED
  INTERRUPTED
  FAILED
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Account {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique @db.VarChar(320)
  passwordHash String           @map("password_hash") @db.VarChar(512)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime?        @map("last_login_at") @db.Timestamptz(3)
  isActive     Boolean          @default(true) @map("is_active")
  profile      Profile?
  sessions     AccountSession[]

  @@map("accounts")
}

model AccountSession {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("account_sessions")
}

model Profile {
  id                  String        @id @default(uuid()) @db.Uuid
  accountId           String        @unique @map("account_id") @db.Uuid
  role                Role          @default(USER)
  displayName         String        @map("display_name") @db.VarChar(120)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  account             Account       @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cubeData            CubeData[]
  roleChangesReceived RoleChange[]  @relation("RoleChangeTarget")
  roleChangesMade     RoleChange[]  @relation("RoleChangeActor")
  roleRequests        RoleRequest[] @relation("RoleRequestTarget")
  roleRequestsDecided RoleRequest[] @relation("RoleRequestActor")

  @@index([role])
  @@map("profiles")
}

/// One requested role at registration, never an automatic grant. Terminal decisions are immutable.
model RoleRequest {
  id                 String            @id @default(uuid()) @db.Uuid
  profileId          String            @unique @map("profile_id") @db.Uuid
  requestedRole      Role              @map("requested_role")
  status             RoleRequestStatus @default(PENDING)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt          DateTime?         @map("decided_at") @db.Timestamptz(3)
  decidedByProfileId String?           @map("decided_by_profile_id") @db.Uuid
  reason             String?           @db.VarChar(240)
  profile            Profile           @relation("RoleRequestTarget", fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  decidedBy          Profile?          @relation("RoleRequestActor", fields: [decidedByProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([decidedByProfileId])
  @@map("role_requests")
}

model CubeData {
  id              String         @id @default(uuid()) @db.Uuid
  profileId       String         @map("profile_id") @db.Uuid
  type            CubeDataType
  runId           String?        @map("run_id") @db.Uuid
  sessionIndex    Int?           @map("session_index")
  phaseIndex      Int?           @map("phase_index")
  status          CubeDataStatus @default(CREATED)
  inputData       Json?          @map("input_data") @db.JsonB
  outputData      Json?          @map("output_data") @db.JsonB
  inferenceData   Json?          @map("inference_data") @db.JsonB
  metadata        Json?          @db.JsonB
  engineVersion   String         @map("engine_version") @db.VarChar(64)
  scenarioVersion String         @map("scenario_version") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile         Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  run             CubeData?      @relation("RunSessions", fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessions        CubeData[]     @relation("RunSessions")

  @@unique([runId, sessionIndex])
  @@unique([runId, phaseIndex])
  @@index([profileId])
  @@index([runId])
  @@index([type])
  @@index([createdAt])
  @@index([profileId, createdAt])
  @@map("cube_data")
}

/// A capability the backend can check, e.g. "role.assign". Keys are fixed identifiers defined in
/// src/permissions.ts and never come from a client.
model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(64)
  description String           @db.VarChar(240)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

/// Direct grants of a permission to a role. Rows are explicit (no runtime inheritance), so what a
/// role can do is readable straight from this table.
model RolePermission {
  role         Role
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Append-only audit of role assignments. Profile links become NULL if a profile is deleted, so the
/// history survives account deletion. A NULL actor marks the local one-time SUPERDEV bootstrap.
model RoleChange {
  id              String   @id @default(uuid()) @db.Uuid
  targetProfileId String?  @map("target_profile_id") @db.Uuid
  actorProfileId  String?  @map("actor_profile_id") @db.Uuid
  fromRole        Role?    @map("from_role")
  toRole          Role     @map("to_role")
  reason          String?  @db.VarChar(240)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  target          Profile? @relation("RoleChangeTarget", fields: [targetProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actor           Profile? @relation("RoleChangeActor", fields: [actorProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([targetProfileId, createdAt])
  @@index([actorProfileId])
  @@index([createdAt])
  @@map("role_changes")
}
